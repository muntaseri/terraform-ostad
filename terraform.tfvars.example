project_name       = "terraform-ostad"
environment        = "dev"
aws_region         = "us-east-1"
vpc_cidr           = "10.0.0.0/16"
owner              = "team-name"
single_nat_gateway = true
# Set to your public IPv4 address with a /32 suffix to enable bastion SSH.
# allowed_ssh_cidr = "198.51.100.10/32"
app_instance_type     = "t3.micro"
app_min_size          = 2
app_desired_capacity  = 2
app_max_size          = 4
